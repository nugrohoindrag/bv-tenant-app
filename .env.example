# mock = data lokal (localStorage); semua layar berfungsi tanpa backend (default saat dev)
# http = backend Go BuildingVision P1 (/api/v1/tenant/*); mode utama
VITE_API_MODE=http
# Public intake (sudah ada di backend, feature-flag per organization): slug organization + intake key property
VITE_ORG_SLUG=graha-pangeran
VITE_INTAKE_KEY=
# Backend target untuk proxy dev (vite.config.ts)
BV_API_URL=http://localhost:8080
# Base URL API absolut. Kosong = relatif (/api → proxy Vite / reverse-proxy). WAJIB untuk build native Capacitor (Android/iOS).
VITE_API_BASE=
# Push native (Capacitor FCM). Kosong = otomatis aktif hanya bila android/app/google-services.json ada saat build.
# true/false = paksa. JANGAN true tanpa konfigurasi Firebase: register() membuat app Android crash.
VITE_FCM_ENABLED=
# Nomor WhatsApp pengelola cadangan untuk layar login ("Lupa password?") bila perangkat belum pernah login (format 08…/62…)
VITE_SUPPORT_WHATSAPP=
